# Environment Configuration - Copy to .env and customize

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development

# Database/Storage
DATA_DIRECTORY=./data
CACHE_BACKEND=memory
CACHE_TTL=3600

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# Model Configuration
MAX_FORECAST_STEPS=365
DEFAULT_FORECAST_PERIODS=365
MODEL_CACHE_ENABLED=true

# Performance
CONNECTION_POOL_SIZE=10
MAX_UPLOAD_SIZE_MB=500

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ENV=development
DEBUG=true
